LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEYS=key-1,key-2,key-3
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
MAX_TOKENS=3000
ENABLE_COMPRESSION=true
LLM_TIMEOUT_SECONDS=60
GEMINI_RETRY_ATTEMPTS=3
GEMINI_RETRY_BACKOFF_SECONDS=5
LOG_LEVEL=INFO

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
ENV=development

# GitHub Configuration (for GitHub App)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Extension Configuration
EXTENSION_API_KEY=
EXTENSION_ALLOWED_ORIGINS=http://localhost:3000,chrome-extension://*
